# Copy to ignored .env and supply values locally; never commit actual credentials.
# Empty passwords intentionally fail Compose validation.
# Preserve the username used by an existing database.
# Fresh-lab initialization creates the fixed iam/openfga databases; this is not
# a credential-rotation procedure for existing volumes or running services.
POSTGRES_USER=iam
# Supply the raw password, not a URI-percent-encoded value. OpenFGA v1.8.2
# receives it separately via OPENFGA_DATASTORE_PASSWORD for migrate and run;
# OPENFGA_DATASTORE_URI contains only the database address, never credentials.
# When using a dotenv file, single-quote literal values containing $ or #;
# alternatively inject the raw value through the process environment.
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Required for actual resource authorization; use the deployed store/model IDs.
OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=
# Optional explicit demo-user credential setup; export securely when approved.
# IAM_SET_DEMO_PASSWORDS=true
# IAM_DEMO_ALICE_PASSWORD=
# IAM_DEMO_BOB_PASSWORD=
# Direct host API execution (Compose maps POSTGRES_PASSWORD automatically):
# SPRING_DATASOURCE_PASSWORD=
